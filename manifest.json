{
  "manifest_version": 3,
  "name": "Sensitive Content Detector",
  "version": "1.0.0",
  "description": "Local AI message analysis and rule-based webpage protection with user-controlled phrase review.",

  "action": {
    "default_title": "Sensitive Content Detector",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["flagging.css"],
      "js": ["detector.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
